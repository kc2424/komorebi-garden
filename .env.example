# Pl@ntNet API key — get one at https://my.plantnet.org/settings/api-key
# Never commit the real key. Copy to .env.local for local dev:
#   cp .env.example .env.local
PLANTNET_API_KEY=

# Supabase (sync) — never commit real keys
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key>
# Set true only when SMTP/mail delivery is operational (does not affect already-authenticated sync)
# VITE_AUTH_EMAIL_READY=true

# Native identification API origin (Capacitor builds only; web uses same-origin /api)
# VITE_IDENTIFICATION_API_BASE_URL=https://komorebi-garden.vercel.app
